# Supabase
SUPABASE_URL=https://ysynltkotzizayjtoujf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (for embeddings + Claude Opus on-demand barrio analysis)
OPENAI_API_KEY=

# MercadoLibre OAuth — "house machine" app (CERTIFICADA, role Buscador, PKCE)
ML_APP_ID=5245450773314516
ML_CLIENT_SECRET=

# Residential proxy (ProxyEmpire — required for ML API, ZP, AP since April 2025)
# Format: http://USER:PASS@HOST:PORT
# Without this, ML API returns 403 PolicyAgent and ZP/AP get blocked.
# Leave empty in dev to run scripts direct (will fail on production sources).
RESIDENTIAL_PROXY_URL=

# Proxy budget — hard ceiling on requests per script run (safety net).
# Defends against runaway loops or oversized batches burning proxy GB.
# Default 5000. Set 0 to disable (not recommended).
# ALSO set a monthly spend limit on ProxyEmpire dashboard (Subscriptions → Limits).
PROXY_MAX_REQUESTS=5000
